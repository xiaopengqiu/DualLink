# Copy to .env for local development. Production uses /etc/dual-link.env.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
SECURE_COOKIES=false
TRUST_PROXY=0
DEFAULT_PROVIDER=codex
WORKER_CONCURRENCY=1
AI_TIMEOUT_MS=180000

# native uses the current service user's CLI; docker isolates every job.
CLI_MODE=native
CODEX_BIN=codex
CLAUDE_BIN=claude
CODEX_MODEL=
CLAUDE_MODEL=
# Omit homes to use the service account's normal credentials.
# CODEX_HOME=/var/lib/dual-link/.codex
# CLAUDE_CONFIG_DIR=/var/lib/dual-link/.claude
CODEX_LOAD_USER_CONFIG=false
CLAUDE_SAFE_MODE=true
CLAUDE_BARE_MODE=false
AI_RUNNER_IMAGE=dual-link-ai:1.0.0

# API credentials belong only on the server. Never put them in VITE_* variables.
# CODEX_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# Optional LAN ICE server, not necessary on a simple Wi-Fi network.
# STUN_URL=stun:your-stun.example.com:3478

# v1.1 voice: credentials stay on the server, never in the desktop/web build.
# Set API key and workspace for the same Model Studio region.
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
ASR_REGION=cn-beijing
ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
ASR_MAX_SESSION_MINUTES=120
# Total audio minutes of both tracks per account per UTC day (480 = ~4h dual-track).
ASR_DAILY_MINUTES=480
AUDIO_RETENTION_DAYS=7
# Per-account retained raw audio cap (512 MiB). Set retention to 0 to keep text only.
AUDIO_MAX_USER_BYTES=536870912
INTERVIEW_DEFAULT_PROVIDER=codex
INTERVIEW_DEFAULT_MODE=transcript
INTERVIEW_AUDIO_WINDOW_SECONDS=120
INTERVIEW_AI_TIMEOUT_MS=90000
INTERVIEW_CONTEXT_CHARS=40000
INTERVIEW_AUTO_DEBOUNCE_MS=800
# Persistent Codex process per interview; use exec for older CLI compatibility.
INTERVIEW_CODEX_TRANSPORT=app-server
INTERVIEW_REASONING_EFFORT=low
# Optional direct Bailian streaming text provider (uses DASHSCOPE_API_KEY by default).
# INTERVIEW_TEXT_API_KEY=
# INTERVIEW_TEXT_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
INTERVIEW_TEXT_MODEL=qwen-flash
INTERVIEW_MAX_OUTPUT_TOKENS=1800

# v1.2 direct audio understanding (Qwen Omni). Falls back to DASHSCOPE key/workspace/ASR region.
# OMNI_API_KEY=
# OMNI_WORKSPACE_ID=
# OMNI_REGION=cn-beijing
# OMNI_WS_URL=wss://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
OMNI_MODEL=qwen3.8-omni-flash-realtime
# Comma-separated server-authorized models shown in the account/session dropdown.
# OMNI_MODELS=qwen3.8-omni-flash-realtime,qwen3.5-omni-flash-realtime
