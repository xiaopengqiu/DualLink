{
  "name": "@dual-link/desktop",
  "version": "1.6.0",
  "private": true,
  "description": "双端互联 Windows 截图客户端",
  "author": "Dual Link",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepackage:win": "node ../../scripts/build-update-launcher.mjs",
    "package:win": "electron-builder --win nsis portable --x64 --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cn.duallink.client",
    "productName": "双端互联",
    "copyright": "Copyright © 2026 Dual Link",
    "directories": {
      "output": "../../release/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../../.local/update-launcher.exe",
        "to": "update-launcher.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DualLink-${version}-${arch}-setup.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "双端互联"
    },
    "portable": {
      "artifactName": "DualLink-${version}-${arch}-portable.exe"
    }
  }
}
